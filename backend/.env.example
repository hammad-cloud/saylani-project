PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hcm-lite
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Optional: create the first Admin on boot instead of the first-run screen
COMPANY_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# LLM provider (server only, never sent to the browser). Any OpenAI-compatible API with tool calling.
# Groq (free):   AI_BASE_URL=https://api.groq.com/openai/v1                          AI_MODEL=openai/gpt-oss-120b
# Gemini (free): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.5-flash
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_HOURLY_LIMIT=20

# Office timezone offset in minutes from UTC (Pakistan = 300)
TZ_OFFSET_MINUTES=300
